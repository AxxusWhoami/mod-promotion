#
#  NOTE: Hunter cannot equip an OFFHAND item — omit EQUIPMENT_SLOT_HUNTER_OFFHAND
#        from this file (or leave it set to 0). Setting a value there has no effect
#        because the Hunter gear set has no offhand slot.
#
#  TIP: Item IDs can be looked up at https://www.wowhead.com/wotlk/item=<ID>
#
