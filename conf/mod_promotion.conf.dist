#######################################################
### AzerothCore Module Promotion configuration file ###
#######################################################
[worldserver]

###################################################################################################
# SECTION INDEX
#
#    SETTIGNS MODULE
#    CLASS CONFIG
#
###################################################################################################

######################################################################################################
#	SETTIGNS MODULE
#
#		NpcPromotion.enable
#
#			Description:	Variable that enables or disables the module
#
#			Example:	"true" - (Enabled)
#						"false" - (Disabled)
#
#        Default:     true

promotionEnable.enable=true

#
#
#     LearnSpells
#
#     Description: Teach all trainable class spells (up to LevelForPromotion) during the promotion.
#                  Mirrors the logic of mod-learn-spells. Includes faction-specific extras
#                  (racial mounts, Mage portals/teleports, Paladin seals, etc.).
#
#     Example: true  - (teach all class spells, default)
#              false - (skip spell teaching)
#
#     Default: learnSpells.enable = true
#

learnSpells.enable = true

#
#
#     MoneyRewardPromotion
#
#     Description: Amount of promotion for character
#
#     Example: 10 - (10 cobber)
#              10000000 - (1000 gold)
#
#     Default: 10000000
#

MoneyRewardValue = 10000000

#
#
#     Level Promotion
#
#     Description: Now you can set the level you want for the promotion
#
#     Example: 80 - ( Character Level )
#              70 - ( Character Level )
#
#     Default: LevelForPromotion = 80
#

LevelForPromotion = 80

#
#
#     Promotion.DKRequiredLevel
#
#     Description: Exact level a Death Knight must be to receive the promotion.
#                  Death Knights start at 55, so the default matches that.
#                  Adjust only if your server modifies the DK starting level.
#
#     Default: Promotion.DKRequiredLevel = 55
#

Promotion.DKRequiredLevel = 55

#
#
#     Promotion.MinAccountAge
#
#     Description: Minimum account age in days required to claim a promotion.
#                  Prevents freshly registered accounts from instantly claiming the reward.
#                  Set to 0 to disable (any account age allowed).
#
#     Example: 7  - account must be at least 7 days old
#              30 - account must be at least 30 days old
#              0  - disabled (default)
#
#     Default: Promotion.MinAccountAge = 0
#

Promotion.MinAccountAge = 0

#
#
#     Promotion.ConfirmationStep
#
#     Description: When enabled, the player must confirm their specialization choice
#                  through a second gossip menu before the promotion is granted.
#                  Prevents accidental clicks.
#
#     Example: true  - require confirmation (recommended for live servers)
#              false - grant promotion immediately on spec selection (default)
#
#     NOTE: Requires npc_text ID 80004. Apply the following SQL before enabling:
#           data/sql/db-world/updates/2026_07_03_add_promotion_confirmation_text.sql
#
#     Default: Promotion.ConfirmationStep = false
#

Promotion.ConfirmationStep = false

#
#
#     Promotion.AnnounceToWorld
#
#     Description: When enabled, a server-wide message is sent every time a player
#                  successfully claims their promotion.
#                  Format: [Promocion] <name> ha obtenido la Promocion de Nivel!
#
#     Example: true  - broadcast to all players online
#              false - no announcement (default)
#
#     Default: Promotion.AnnounceToWorld = false
#

Promotion.AnnounceToWorld = false

#
#
#     MountPromotion
#
#     Description: Grant a race-specific ground mount and/or flying mount on promotion.
#
#     mountGround.enable
#         true  - give the race-appropriate ground mount (default)
#         false - skip ground mount
#
#     mountFlying.enable
#         true  - give the race-appropriate flying mount
#         false - skip flying mount (default)
#
#     Per-race ground mount spell IDs (override if desired):
#         mountGround.Human    = 470     (Brown Horse)
#         mountGround.Dwarf    = 6898    (Brown Ram)
#         mountGround.NightElf = 10789   (Striped Frostsaber)
#         mountGround.Gnome    = 17453   (Blue Mechanostrider)
#         mountGround.Draenei  = 35710   (Brown Elekk)
#         mountGround.BloodElf = 33660   (Red Hawkstrider)
#         mountGround.Orc      = 5784    (Brown Wolf)
#         mountGround.Undead   = 17463   (Black Skeletal Horse)
#         mountGround.Tauren   = 18989   (Gray Kodo)
#         mountGround.Troll    = 10796   (Emerald Raptor)
#
#     Per-race flying mount spell IDs (override if desired):
#         mountFlying.Human    = 34767   (Swift Green Gryphon)
#         mountFlying.Dwarf    = 34769   (Swift Blue Gryphon)
#         mountFlying.NightElf = 41513   (Swift Purple Hippogryph)
#         mountFlying.Gnome    = 34768   (Swift Red Gryphon)
#         mountFlying.Draenei  = 34769   (Swift Blue Gryphon)
#         mountFlying.BloodElf = 40192   (Swift Purple Wind Rider)
#         mountFlying.Orc      = 40193   (Swift Yellow Wind Rider)
#         mountFlying.Undead   = 40194   (Swift Red Wind Rider)
#         mountFlying.Tauren   = 40195   (Swift White Wind Rider)
#         mountFlying.Troll    = 40192   (Swift Purple Wind Rider)
#

mountGround.enable = true
mountFlying.enable = false

# Uncomment and change values to override per-race mounts:
# mountGround.Human    = 470
# mountGround.Dwarf    = 6898
# mountGround.NightElf = 10789
# mountGround.Gnome    = 17453
# mountGround.Draenei  = 35710
# mountGround.BloodElf = 33660
# mountGround.Orc      = 5784
# mountGround.Undead   = 17463
# mountGround.Tauren   = 18989
# mountGround.Troll    = 10796

# mountFlying.Human    = 34767
# mountFlying.Dwarf    = 34769
# mountFlying.NightElf = 41513
# mountFlying.Gnome    = 34768
# mountFlying.Draenei  = 34769
# mountFlying.BloodElf = 40192
# mountFlying.Orc      = 40193
# mountFlying.Undead   = 40194
# mountFlying.Tauren   = 40195
# mountFlying.Troll    = 40192

#
#
#   Bags Enable
#
#   Description: Configuration for the backpacks in the promotion
#   
#   Default: bagEnable.enable = true (enabled backpacks promotion)
#   Default: bagReward.Id = 14156 Bottomless Bag Binds when equipped 18 Slot Bag)
#   Default: automaticallyEquippedbags.enable = true (Allows In The Promotion To Equip The Bags)
#
#

bagEnable.enable = true
equippedbags.enable = true
bagReward.Id = 41599

#
#
#     TeleportOnPromotion
#
#     Description: Teleport the character to their faction capital after the promotion is granted.
#
#     Example: true  - (teleport enabled, default)
#              false - (stay in place)
#
#     Default: teleport.enable = true
#

teleport.enable = true

#
#     Teleport destination coordinates (used when teleport.enable = true).
#     Override these to send players to a custom capital or hub.
#
#     Default: Stormwind Keep (Alliance) and Valley of Strength in Orgrimmar (Horde).
#
#     teleport.Alliance.MapId  = 0
#     teleport.Alliance.AreaId = 1519
#     teleport.Alliance.X      = -8888.54
#     teleport.Alliance.Y      =   573.119
#     teleport.Alliance.Z      =    92.621
#     teleport.Alliance.O      =     0.732
#
#     teleport.Horde.MapId     = 1
#     teleport.Horde.AreaId    = 1637
#     teleport.Horde.X         =  1136.16
#     teleport.Horde.Y        = -4385.84
#     teleport.Horde.Z        =   30.206
#     teleport.Horde.O        =    3.063
#

###################################################################################################

###################################################################################################
#
#  CLASS CONFIG
